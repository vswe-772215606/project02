{
  "name": "@chayxana/master",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "electron-builder --win --x64",
    "package:win:portable": "electron-builder --win portable --x64",
    "build:printer": "bash ./scripts/build-printer.sh",
    "build:printer:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-printer.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'no lint configured yet'"
  },
  "build": {
    "appId": "com.chayxana.master",
    "electronVersion": "31.7.7",
    "productName": "Chayxana Master",
    "copyright": "Copyright © 2025 Chayxana",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,txt,map}",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      { "from": "resources/bin", "to": "bin" },
      { "from": "prisma/schema.prisma", "to": "prisma/schema.prisma" },
      { "from": "prisma/migrations", "to": "prisma/migrations" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "ChayxanaMaster-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chayxana Master",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.17.1",
    "@tanstack/react-query": "^5.100.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "lucide-react": "^1.14.0",
    "p-queue": "6.6.2",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.13",
    "prisma": "^6.17.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
