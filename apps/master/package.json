{
  "name": "@chayxana/master",
  "version": "0.1.3",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "build": "pnpm run package:prepare && electron-vite build",
    "package:prepare": "node ./scripts/prepare-prisma-package.mjs",
    "package:win": "pnpm run build && electron-builder --win --x64",
    "package:win:next": "node ./scripts/package-win-next.mjs",
    "package:win:portable": "pnpm run build && electron-builder --win portable --x64",
    "build:printer": "bash ./scripts/build-printer.sh",
    "build:printer:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-printer.ps1",
    "gallery": "pnpm run typecheck:gallery && vite build --config vite.gallery.config.ts",
    "gallery:page": "pnpm run gallery && node ./scripts/build-gallery-page.mjs",
    "typecheck": "tsc -b",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:gallery": "tsc --noEmit -p tsconfig.gallery.json",
    "lint": "echo 'no lint configured yet'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.chayxana.master",
    "electronVersion": "31.7.7",
    "productName": "Chayxana Master",
    "copyright": "Copyright © 2025 Chayxana",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,txt,map}",
      "!node_modules/.cache/**/*",
      {
        "from": "build/prisma-package/node_modules/@prisma/client",
        "to": "node_modules/@prisma/client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/prisma-package/node_modules/.prisma/client",
        "to": "node_modules/.prisma/client",
        "filter": [
          "**/*.js",
          "**/*.json",
          "**/*.d.ts",
          "**/*.prisma",
          "**/*.mjs",
          "**/*.wasm"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/prisma-package/node_modules/.prisma/client",
        "to": "app.asar.unpacked/node_modules/.prisma/client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ChayxanaMaster-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chayxana Master",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.8",
    "bcryptjs": "^3.0.3",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.0",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "p-queue": "6.6.2",
    "pdfkit": "^0.18.0",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "telegraf": "^4.16.3",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.13",
    "prisma": "^6.17.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
